# Midnight Network Environment
# Copy to .env in your project root
# Managed by: set-network.sh

# Network: standalone | preprod
MIDNIGHT_NETWORK=standalone

# Wallet seed (64-char hex). Generate with: openssl rand -hex 32
MIDNIGHT_SEED=

# Proof server (always local, serves both networks)
PROOF_SERVER_URL=http://127.0.0.1:6300
